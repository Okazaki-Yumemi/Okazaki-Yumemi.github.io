{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hidden-space-writer",
  "main": "../.writer-build/worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "d1_databases": [{ "binding": "TRAFFIC_DB", "database_name": "hidden-space-traffic", "database_id": "d6c21752-243b-48e0-94d7-ce6472057617" }],
  "ratelimits": [{ "name": "TRAFFIC_LIMITER", "namespace_id": "22001", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["18 18 * * *"] },
  "assets": {
    "directory": "../.writer-build/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://hidden-space-writer.ymgfc-cn-blog.workers.dev",
    "GITHUB_CLIENT_ID": "Iv23liQMQSCe7SYo9Iym"
  },
  "observability": {
    "enabled": false
  }
}
