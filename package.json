{
  "name": "ymgfc-cn-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "writer:build": "node writer/build.mjs",
    "writer:test": "node --test writer/test/*.test.mjs",
    "writer:deploy": "npm run writer:build && wrangler deploy --config writer/wrangler.jsonc",
    "writer:setup": "node writer/setup.mjs",
    "clean": "hexo clean",
    "build": "hexo generate",
    "server": "hexo server",
    "publish:root": "npm run build && npm run check && node tools/publish-root.mjs",
    "check": "node tools/check-build.mjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "hexo": "8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "5.7.0",
    "markdown-it-mathjax3": "^4.3.2",
    "medium-zoom": "^1.1.0"
  },
  "devDependencies": {
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.57.0",
    "markdown-it": "^15.0.2",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  }
}
